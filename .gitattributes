# Default to LF line endings for all text files
* text=auto eol=lf

# Ensure Unix shell scripts use LF
*.sh text eol=lf

# Ensure the extensionless Maven wrapper uses LF
mvnw text eol=lf

# Windows batch files need CRLF line endings
*.cmd text eol=crlf
*.bat text eol=crlf

# The age files that the Codex keyring tests decrypt are binary
*.age binary
