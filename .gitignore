# IntelliJ IDEA project settings, except shared code-style configuration.
.idea/*
*.iml
!.idea/codeStyles/
.idea/codeStyles/*
!.idea/codeStyles/Project.xml
!.idea/codeStyles/codeStyleConfig.xml

# Maven build output.
**/target/

# Disposable CAT-generated files.
.cat/sessions/
# Earlier versions of CAT kept these files in .cat/work/. SessionStart moves the session directories out but leaves
# .cat/work/temp, which earlier sessions used as their temporary directory.
.cat/work/
