{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Failure impact",
	"type": "object",
	"additionalProperties": false,
	"required": ["impact", "rationale"],
	"properties": {
		"impact": {"enum": ["blocking", "self-recovering"]},
		"rationale": {"description": "The evidence that decided the impact.", "type": "string", "pattern": "\\S"}
	}
}
