<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.holdmyspot.cat</groupId>
		<artifactId>client</artifactId>
		<version>1.0</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>client-distribution</artifactId>
	<name>Distribution</name>

	<properties>
		<cat.release.public-key></cat.release.public-key>
		<!-- The release commit's first 12 hexadecimal digits; empty to use the HEAD of the working tree -->
		<cat.build></cat.build>
		<cat.config.directory>${project.basedir}/../../config</cat.config.directory>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-common-installer</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-claude-installer</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-codex-installer</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-common-agents</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-common-cli</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-common-cli</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-common-installer</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-common-plugin</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-common-skills</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-common-rules</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-claude-cli</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-claude-plugin</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-claude-rules</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-claude-skills</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-codex-cli</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-codex-skills</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-codex-rules</artifactId>
		</dependency>
		<dependency>
			<groupId>com.holdmyspot.cat</groupId>
			<artifactId>client-codex-plugin</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-compress</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.cowwoc.requirements</groupId>
			<artifactId>requirements-java</artifactId>
		</dependency>
		<dependency>
			<groupId>tools.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-yaml</artifactId>
		</dependency>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-runtime-modules</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<outputDirectory>${project.build.directory}/modules</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>shellcheck</id>
						<phase>test</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>shellcheck</executable>
							<arguments>
								<argument>-x</argument>
								<argument>${project.basedir}/../lifecycle/src/main/release/cat.sh</argument>
								<argument>${project.basedir}/../lifecycle/src/main/release/generate-cat-sh.sh</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>build-native-distributions</id>
						<phase>package</phase>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>com.holdmyspot.cat.distribution.DistributionMain</mainClass>
							<arguments>
								<argument>${project.basedir}/../../..</argument>
								<argument>${project.build.directory}/modules</argument>
								<argument>${project.build.directory}/release</argument>
								<argument>${cat.release.public-key}</argument>
								<argument>${cat.build}</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
