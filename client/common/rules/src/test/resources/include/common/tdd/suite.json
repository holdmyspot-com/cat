        "selected": [
          "include/common/tdd.md"
        ]
      }
    },
    "behavior-preserving-refactor": {
      "measures": [
        "organic_selection",
        "application"
      ],
      "route_expectation": {
        "mode": "organic",
        "not_selected": [
          "include/common/tdd.md"
        ]
      }
    }
  }
}
