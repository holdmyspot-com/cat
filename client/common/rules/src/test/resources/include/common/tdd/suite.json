{
  "schema_version": 3,
  "purpose": "certification",
  "routing_owner": "common/default-rules.md",
  "sprt": {
    "accept_pass_rate": 0.95,
    "reject_pass_rate": 0.85,
    "false_accept_rate": 0.05,
    "false_reject_rate": 0.05
  },
  "scenarios": {
    "later-recovery-branch": {
      "measures": ["organic_selection", "application"],
      "route_expectation": {
        "mode": "organic",
        "selected": ["include/common/tdd.md"]
      }
    },
    "dormant-public-path": {
      "measures": ["organic_selection", "application"],
      "route_expectation": {
        "mode": "organic",
        "selected": ["include/common/tdd.md"]
      }
    },
    "behavior-preserving-refactor": {
      "measures": ["organic_selection", "application"],
      "route_expectation": {
        "mode": "organic",
        "not_selected": ["include/common/tdd.md"]
      }
    }
  }
}
