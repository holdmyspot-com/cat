<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.holdmyspot.cat</groupId>
	<artifactId>client</artifactId>
	<version>1.0</version>
	<packaging>pom</packaging>

	<name>Client</name>
	<description>CAT plugin client reactor</description>

	<modules>
		<module>common</module>
		<module>claude</module>
		<module>codex</module>
	</modules>

	<properties>
		<build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
		<cat.config.directory>${project.basedir}/config</cat.config.directory>
		<!--
			The TestNG group that tests run (all groups when empty) and the group they skip. By default, tests skip group
			"native", whose tests start real nested harness sessions.
		-->
		<cat.test.groups/>
		<cat.test.excludedGroups>native</cat.test.excludedGroups>
		<!-- The harness that native tests start: claude or codex. Native tests skip when it is empty. -->
		<cat.native.harness/>
		<!--
			The directory that holds test fixtures, including those that a harness runner consumes. A build inside a harness
			session uses the session's temporary directory (see the profiles "claude-session" and "codex-session"). Any other
			build, such as CI, uses the system's temporary directory. A directory inside the project would expose each test's
			fixtures to the tests that read the project's prompt tests, while the fixtures are created and deleted.
		-->
		<cat.session.temp>${java.io.tmpdir}</cat.session.temp>
		<checkstyle.version>14.3.0</checkstyle.version>
		<commons-compress.version>1.28.0</commons-compress.version>
		<exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
		<jackson.version>3.2.3</jackson.version>
		<junit-platform.version>1.14.4</junit-platform.version>
		<logback.version>1.6.5</logback.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
		<maven.compiler.release>27</maven.compiler.release>
		<maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
		<maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
		<maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
		<maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
		<maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
		<maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
		<maven.version>3.10.0</maven.version>
		<pmd.version>7.28.0</pmd.version>
		<pouch.version>10.3</pouch.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<requirements.version>13.2</requirements.version>
		<slf4j.version>2.0.20</slf4j.version>
		<testng.version>7.12.0</testng.version>
		<test.thread.count>4</test.thread.count>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-classic</artifactId>
				<version>${logback.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-compress</artifactId>
				<version>${commons-compress.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-common-agents</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-common-cli</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-common-plugin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-common-skills</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-common-rules</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-distribution</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-claude-cli</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-claude-plugin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-claude-rules</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-claude-skills</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-codex-cli</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-codex-skills</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-codex-rules</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.holdmyspot.cat</groupId>
				<artifactId>client-codex-plugin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>tools.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>${jackson.version}</version>
			</dependency>
			<dependency>
				<groupId>tools.jackson.dataformat</groupId>
				<artifactId>jackson-dataformat-yaml</artifactId>
				<version>${jackson.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.cowwoc.pouch</groupId>
				<artifactId>pouch-core</artifactId>
				<version>${pouch.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.cowwoc.requirements</groupId>
				<artifactId>requirements-java</artifactId>
				<version>${requirements.version}</version>
			</dependency>
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-nop</artifactId>
				<version>${slf4j.version}</version>
				<scope>runtime</scope>
			</dependency>
			<dependency>
				<groupId>org.testng</groupId>
				<artifactId>testng</artifactId>
				<version>${testng.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		WORKAROUND: https://github.com/apache/maven-surefire/issues/3521
		Surefire runs TestNG through the JUnit Platform and opens packages of org.junit.platform.commons, but puts that
		module on the class path unless the project declares it, so the JVM warns that the module is unknown. Keep the
		version equal to the JUnit Platform version that Surefire uses.
		-->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-commons</artifactId>
			<version>${junit-platform.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>build-helper-maven-plugin</artifactId>
					<version>${build-helper-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>${exec-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<version>${maven-failsafe-plugin.version}</version>
					<configuration>
						<classpathDependencyExcludes>
							<classpathDependencyExclude>org.slf4j:slf4j-nop</classpathDependencyExclude>
						</classpathDependencyExcludes>
						<parallel>methods</parallel>
						<threadCount>${test.thread.count}</threadCount>
						<properties>
							<property>
								<name>usedefaultlisteners</name>
								<value>false</value>
							</property>
						</properties>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>${maven-checkstyle-plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>com.puppycrawl.tools</groupId>
							<artifactId>checkstyle</artifactId>
							<version>${checkstyle.version}</version>
						</dependency>
					</dependencies>
					<executions>
						<execution>
							<phase>process-test-classes</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<configLocation>${cat.config.directory}/checkstyle.xml</configLocation>
						<consoleOutput>true</consoleOutput>
						<excludeGeneratedSources>true</excludeGeneratedSources>
						<failOnViolation>true</failOnViolation>
						<includeTestSourceDirectory>true</includeTestSourceDirectory>
						<linkXRef>false</linkXRef>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<failOnWarning>true</failOnWarning>
						<showWarnings>true</showWarnings>
						<compilerArgs>
							<arg>-Xlint:all,-exports,-requires-automatic,-module</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-dependency-plugin</artifactId>
					<version>${maven-dependency-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>${maven-enforcer-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
					<configuration>
						<classpathDependencyExcludes>
							<classpathDependencyExclude>org.slf4j:slf4j-nop</classpathDependencyExclude>
						</classpathDependencyExcludes>
						<parallel>methods</parallel>
						<threadCount>${test.thread.count}</threadCount>
						<systemPropertyVariables>
							<cat.native.harness>${cat.native.harness}</cat.native.harness>
							<cat.session.temp>${cat.session.temp}</cat.session.temp>
						</systemPropertyVariables>
						<!-- Git's detached background maintenance would keep changing a test repository's .git directory
						while the test deletes it. -->
						<environmentVariables>
							<GIT_CONFIG_COUNT>2</GIT_CONFIG_COUNT>
							<GIT_CONFIG_KEY_0>maintenance.auto</GIT_CONFIG_KEY_0>
							<GIT_CONFIG_VALUE_0>false</GIT_CONFIG_VALUE_0>
							<GIT_CONFIG_KEY_1>gc.auto</GIT_CONFIG_KEY_1>
							<GIT_CONFIG_VALUE_1>0</GIT_CONFIG_VALUE_1>
						</environmentVariables>
						<includes>
							<include>**/*Test.java</include>
						</includes>
						<properties>
							<property>
								<name>usedefaultlisteners</name>
								<value>false</value>
							</property>
							<!-- TestNG properties rather than surefire groups, which fail in modules without TestNG -->
							<property>
								<name>groups</name>
								<value>${cat.test.groups}</value>
							</property>
							<property>
								<name>excludegroups</name>
								<value>${cat.test.excludedGroups}</value>
							</property>
						</properties>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven-jar-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-pmd-plugin</artifactId>
					<version>${maven-pmd-plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-core</artifactId>
							<version>${pmd.version}</version>
						</dependency>
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-java</artifactId>
							<version>${pmd.version}</version>
						</dependency>
					</dependencies>
					<executions>
						<execution>
							<phase>process-test-classes</phase>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<analysisCache>true</analysisCache>
						<includeTests>true</includeTests>
						<linkXRef>false</linkXRef>
						<printFailingErrors>true</printFailingErrors>
						<rulesets>
							<ruleset>${cat.config.directory}/pmd.xml</ruleset>
						</rulesets>
						<!--
							BUG: https://github.com/apache/maven-pmd-plugin/pull/726
							PMD warns that it adds the current platform's jrt-fs.jar to auxClasspath because
							maven-pmd-plugin 3.28 does not add the target JDK to its analysis classpath. This
							single warning is intentionally accepted until the merged plugin fix is released.
						-->
						<targetJdk>27</targetJdk>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>require-jdk-27</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>27</version>
								</requireJavaVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<!-- A build inside a Codex session keeps its fixtures in the session's temporary directory. -->
			<id>codex-session</id>
			<activation>
				<property>
					<name>env.CODEX_THREAD_ID</name>
				</property>
			</activation>
			<properties>
				<cat.session.temp>${project.rootDirectory}/../.cat/sessions/${env.CODEX_THREAD_ID}/temp</cat.session.temp>
			</properties>
		</profile>
		<profile>
			<!--
				A build inside a Claude Code session keeps its fixtures in the session's temporary directory. Declared after
				"codex-session", it wins when both variables are set.
			-->
			<id>claude-session</id>
			<activation>
				<property>
					<name>env.CLAUDE_CODE_SESSION_ID</name>
				</property>
			</activation>
			<properties>
				<cat.session.temp>${project.rootDirectory}/../.cat/sessions/${env.CLAUDE_CODE_SESSION_ID}/temp</cat.session.temp>
			</properties>
		</profile>
		<profile>
			<!--
				Runs only the tests in TestNG group "native", which start real nested harness sessions.
				Usage: mvnw -Pnative -Dcat.native.harness=claude|codex verify
			-->
			<id>native</id>
			<properties>
				<cat.test.groups>native</cat.test.groups>
				<cat.test.excludedGroups></cat.test.excludedGroups>
			</properties>
		</profile>
	</profiles>
</project>
