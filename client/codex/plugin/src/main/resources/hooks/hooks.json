{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start.sh\"",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\session-start.cmd\"",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/post-tool-use.sh\"",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\post-tool-use.cmd\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/subagent-start.sh\"",
            "commandWindows": "& \"${PLUGIN_ROOT}\\hooks\\subagent-start.cmd\"",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
