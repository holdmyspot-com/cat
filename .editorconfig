root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 2
tab_width = 2
# Smart tabs: indent with tabs, then align with spaces after that indentation, such as a continuation line aligned
# under an opening parenthesis, so that alignment holds at any tab width
ij_smart_tabs = true
max_line_length = 120

[{*.yaml,*.yml}]
indent_style = space
indent_size = 2
ij_smart_tabs = false
